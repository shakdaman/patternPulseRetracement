//@version=6
indicator("Pattern Pulse D&R Radar - Multi Ticker", shorttitle="D&R Radar Multi", overlay=true)

// --- Input Controls ---
// Batch Selection System (same as Pattern Radar)
batch_group = "📊 Ticker Configuration"
batch_selection = input.string("Batch 2 (8 tickers)", title="Select Ticker Batch", options=["Batch 1 (8 tickers)", "Batch 2 (8 tickers)", "Batch 3 (8 tickers)", "Batch 4 (8 tickers)", "Batch 5 (8 tickers)", "Batch 6 (8 tickers)", "Batch 7 (8 tickers)", "Batch 8 (8 tickers)", "Batch 9 (8 tickers)", "Batch 10 (8 tickers)", "Batch 11 (8 tickers)", "Batch 12 (8 tickers)", "Batch 13 (8 tickers)", "Batch 14 (8 tickers)", "Batch 15 (8 tickers)", "Batch 16 (8 tickers)", "Batch 17 (8 tickers)", "Batch 18 (8 tickers)", "Batch 19 (8 tickers)", "Batch 20 (8 tickers)", "Batch 21 (8 tickers)", "Batch 22 (8 tickers)", "Batch 23 (1 ticker)"], group=batch_group)

// Display Settings
display_group = "📈 Display Settings"
table_position = input.string("Middle Center", title="Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=display_group)
show_performance_info = input.bool(false, title="Show Performance Info", group=display_group)
show_debug_info = input.bool(true, title="Show Debug Information", group=display_group)

// Debug Table Position Settings
debug_group = "🔧 Debug Settings"
debug_main_position = input.string("Middle Right", title="Main Debug Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=debug_group)
debug_state_position = input.string("Middle Left", title="State Debug Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=debug_group)

// --- Batch Selection Function ---
f_get_batch_tickers(batch_name) =>
    switch batch_name
        "Batch 1 (8 tickers)" => ["AMEX:BITO", "AMEX:BLOX", "CBOE:BTCI", "CBOE:HOOW", "AMEX:ULTY", "CBOE:WPAY", "AMEX:YMAG", "NASDAQ:AAL"]
        "Batch 2 (8 tickers)" => ["NASDAQ:AAPL", "NASDAQ:MSFT", "NASDAQ:GOOGL", "NASDAQ:AMZN", "NASDAQ:TSLA", "NASDAQ:META", "NASDAQ:NVDA", "NYSE:ORCL"]
        "Batch 3 (8 tickers)" => ["NYSE:JPM", "NYSE:BAC", "NYSE:WFC", "NYSE:C", "NYSE:GS", "NYSE:MS", "NYSE:AXP", "NYSE:USB"]
        "Batch 4 (8 tickers)" => ["NYSE:XOM", "NYSE:CVX", "NYSE:COP", "NYSE:EOG", "NYSE:SLB", "NYSE:KMI", "NYSE:WMB", "NYSE:OKE"]
